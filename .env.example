# =========================================================
# Commercial Building Bot - Environment Configuration
# Copy this file to ".env" and fill in real values.
# NEVER commit the real ".env" file to version control.
# =========================================================

# Telegram bot token from @BotFather
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Comma-separated list of Telegram numeric user IDs allowed to act as administrators.
# Get your numeric Telegram ID from @userinfobot.
# Example: ADMIN_IDS=111111111,222222222
ADMIN_IDS=111111111

# Database location. For the initial version this is a SQLite file path.
# To migrate later, change the DB backend in database.py (structured for PostgreSQL).
DATABASE_URL=sqlite:///storage/building.db

# Secret key used for signing/backup encryption utilities (generate a random 32+ char string)
SECRET_KEY=change-this-to-a-long-random-secret-string

# Name of the building, shown in headers/receipts
BUILDING_NAME=Commercial Building

# Total number of shops in the building (fixed structure, but configurable)
TOTAL_SHOPS=30

# Currency label used throughout the interface
CURRENCY=ETB

# Default rent due day (day of the Ethiopian month rent is due)
RENT_DUE_DAY=5

# Days before due date to send the first reminder
REMINDER_DAYS_BEFORE=3

# Timezone used for scheduling (Africa/Addis_Ababa)
TIMEZONE=Africa/Addis_Ababa
